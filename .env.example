# 复制为 .env 后填写（.env 不要提交到仓库）
CLOUDFLARE_API_TOKEN=你的CF令牌

# 必须与已有「发布/相册」插件同一个 Pages 项目，/manage 才会挂在同一域名下
CF_PROJECT=entropy-quick-post

# Hexo 源码仓库（不是 Entropyqwe.github.io 那个构建产物仓库）
REPO=Entropyqwe/hexo-firefly-site
BRANCH=main

# 管理密钥：前端只负责输入，校验在云函数里做（写入 Cloudflare Secret）
ADMIN_KEY=请改成你自己的强口令

# 仅需仓库 Contents 写权限的 PAT。
# 如果同一个 Pages 项目里已经配过 GITHUB_TOKEN，这里可以留空（不会覆盖）
GITHUB_TOKEN=
